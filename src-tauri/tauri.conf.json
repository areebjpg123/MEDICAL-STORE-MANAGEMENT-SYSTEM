{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MedicalStoreERP",
  "version": "0.1.0",
  "identifier": "com.medicalstoreerp.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Medical Store ERP",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/areebjpg123/MEDICAL-STORE-MANAGEMENT-SYSTEM/releases/latest/download/latest.json?v={{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDOEI1NUY1NDUyNzQyM0IKUldRN1FpZEY5VldMVEVDZWVLNXJ2WWd5eGd6WmtMSUNxOENLWXBWSXVhcnhMbExzazhBYlpSU1oK"
    }
  }
}
